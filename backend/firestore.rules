rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users Collection: Staff login, BDO credentials & roster
    match /users/{userId} {
      allow read, write: if true;
    }

    // Merchants Collection: Merchant roster, GPS tags & QR statuses
    match /merchants/{merchantId} {
      allow read, write: if true;
    }

    // Visits Collection: BDO field inspection entries, photos & timestamps
    match /visits/{visitId} {
      allow read, write: if true;
    }

    // Immutable Audit Logs: Append-only security audit trail
    match /audit_logs/{logId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // Backups Collection: System backup snapshots
    match /backups/{backupId} {
      allow read, write: if true;
    }

    // Fallback catch-all
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
